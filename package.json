{
  "name": "gordoshex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.1 <23",
    "npm": ">=10.9.2 <11"
  },
  "packageManager": "npm@10.9.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "dev": "vite",
    "build:app": "tsc -p tsconfig.web.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "playwright test",
    "benchmark:app": "vite build --config vite.benchmark.config.ts && node benchmarks/browser-run.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.13.1",
    "eslint": "10.15.0",
    "fast-check": "4.11.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
