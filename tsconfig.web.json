{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"]
  },
  "include": [
    "web/**/*.ts",
    "vite.config.ts",
    "playwright.config.ts",
    "browser/**/*.ts",
    "vite.benchmark.config.ts",
    "benchmarks/browser.ts",
    "benchmarks/memoir.ts"
  ]
}
